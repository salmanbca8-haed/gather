rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.member_ids;
    }

    match /usernameClaims/{username} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.gatherUsername == request.resource.data.username
        && request.resource.data.keys().hasOnly([
          'username', 'display_name', 'bio', 'avatar_path', 'show_last_seen', 'created_at', 'updated_at'
        ])
        && request.resource.data.username is string
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() >= 2
        && request.resource.data.display_name.size() <= 60;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name', 'bio', 'avatar_path', 'show_last_seen', 'last_seen_at', 'updated_at'
        ])
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() >= 2
        && request.resource.data.display_name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && (
          request.resource.data.avatar_path == null
          || request.resource.data.avatar_path == 'avatars/' + uid + '/profile'
        )
        && (
          !('last_seen_at' in request.resource.data)
          || request.resource.data.last_seen_at == null
          || request.resource.data.last_seen_at is timestamp
        )
        && request.resource.data.show_last_seen is bool;
      allow delete: if false;
    }

    match /identities/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'public_encryption_key', 'public_signing_key', 'updated_at'
        ])
        && request.resource.data.public_encryption_key.kty == 'EC'
        && request.resource.data.public_encryption_key.crv == 'P-256'
        && request.resource.data.public_signing_key.kty == 'EC'
        && request.resource.data.public_signing_key.crv == 'P-256';
      allow delete: if false;
    }

    match /keyBackups/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'backup_salt', 'backup_iv', 'backup_ciphertext', 'kdf_iterations', 'updated_at'
        ])
        && request.resource.data.backup_ciphertext is string
        && request.resource.data.backup_ciphertext.size() <= 12000
        && request.resource.data.kdf_iterations == 600000;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isMember(conversationId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create, update: if false;
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isMember(conversationId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && isMember(conversationId)
          && request.resource.data.keys().hasOnly(['last_read_message_id', 'last_read_at']);
        allow update: if signedIn()
          && request.auth.uid == uid
          && isMember(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'last_read_message_id', 'last_read_at'
          ]);
        allow delete: if false;
      }
    }

    match /blocks/{uid}/blocked/{otherUid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && uid != otherUid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
